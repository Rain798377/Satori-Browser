{
  "manifest_version": 2,
  "name": "Satori",
  "version": "2.0",
  "description": "Satori — sidebar companion, new tab, AniList tracker",
  "permissions": [
    "storage",
    "theme",
    "browserSettings",
    "https://graphql.anilist.co/*"
  ],
  "sidebar_action": {
    "default_title": "Satori",
    "default_panel": "sidebar.html"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "background": {
    "page": "background.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "satori@satori",
      "strict_min_version": "109.0"
    }
  }
}